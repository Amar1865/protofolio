# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for JWT authentication tokens (configured on server).
JWT_SECRET="replace-with-strong-random-secret"

# Optional initial administrator bootstrap credentials (server-side only).
ADMIN_EMAIL="admin@meridianwealth.io"
ADMIN_PASSWORD="AdminPassword2026!"
